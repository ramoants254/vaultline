PORT=4001
HOST=0.0.0.0

# Database Connection (auth_db)
DATABASE_URL=postgres://auth_user:auth_db_pass@localhost:5432/auth_db

# Redis Connection
REDIS_URL=redis://localhost:6379

# RabbitMQ Connection
RABBITMQ_URL=amqp://vaultline_mq:mq_secret_pass@localhost:5672

# JWT Configuration
JWT_SECRET=super-secret-vaultline-jwt-key-change-in-prod
JWT_REFRESH_SECRET=super-secret-vaultline-refresh-key-change-in-prod