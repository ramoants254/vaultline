# Vaultline Environment Configurations

# PostgreSQL Credentials
POSTGRES_SUPERUSER=vaultline_admin
POSTGRES_SUPERUSER_PASSWORD=admin_secret_pass

# Database User Credentials (Database-per-service isolation)
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_db_pass
AUTH_DB_NAME=auth_db

LEDGER_DB_USER=ledger_user
LEDGER_DB_PASSWORD=ledger_db_pass
LEDGER_DB_NAME=ledger_db

PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=payments_db_pass
PAYMENTS_DB_NAME=payments_db

FRAUD_DB_USER=fraud_user
FRAUD_DB_PASSWORD=fraud_db_pass
FRAUD_DB_NAME=fraud_db

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=vaultline_mq
RABBITMQ_DEFAULT_PASS=mq_secret_pass
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── M-Pesa Daraja API ────────────────────────────────────────────────────────
# Environment: 'sandbox' for testing, 'production' for live
MPESA_ENVIRONMENT=sandbox

# Daraja app credentials from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Sandbox shortcode (Safaricom test: 174379) / Production: your registered shortcode
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa Online Passkey (from Daraja portal — sandbox default below)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Publicly reachable HTTPS base URL for callbacks (use ngrok in development)
# Example: https://abc123.ngrok.io  →  callbacks hit https://abc123.ngrok.io/api/v1/payments/mpesa/stk-callback
MPESA_CALLBACK_BASE_URL=https://your-tunnel-url.ngrok.io

# B2C Initiator credentials (from Daraja portal — required for withdrawals only)
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=your_security_credential_here